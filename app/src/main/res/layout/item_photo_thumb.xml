<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="88dp" android:layout_height="88dp" android:layout_marginEnd="8dp">

    <ImageView android:id="@+id/thumb_image" android:layout_width="80dp" android:layout_height="80dp" android:layout_gravity="bottom|start" android:background="@drawable/bg_photo_ph" android:scaleType="centerCrop" android:clickable="true" android:focusable="true" android:contentDescription="Photo. Tap to add a caption."/>

    <ImageButton android:id="@+id/thumb_remove" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="top|end" android:background="@drawable/bg_round_btn" android:contentDescription="Remove photo" android:padding="8dp" android:scaleType="centerInside" android:src="@drawable/ic_close" app:tint="@color/cream"/>
</FrameLayout>