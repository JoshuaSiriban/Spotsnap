<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Search"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Search bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/search_box_background">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Search"
                    app:tint="@color/ink" />

                <EditText
                    android:id="@+id/search_edit_text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Search places..."
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted_dark"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:padding="0dp" />

            </LinearLayout>

            <!-- Categories -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="10dp"
                android:text="CATEGORIES"
                android:textColor="@color/muted_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_category_food"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Food"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:fontFamily="sans"
                    app:strokeColor="@color/ink"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_category_travel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Travel"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:fontFamily="sans"
                    app:strokeColor="@color/ink"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_category_study"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Study"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:fontFamily="sans"
                    app:strokeColor="@color/ink"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="8dp" />

            </LinearLayout>

            <!-- Search results -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp"
                android:text="RESULTS"
                android:textColor="@color/muted_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <LinearLayout
                android:id="@+id/search_results_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Cafe Ocampo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/location_card_background">

                    <View
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/photo_placeholder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cafe Ocampo"
                            android:textColor="@color/ink"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="serif" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Cafe · Saved location"
                            android:textColor="@color/muted_dark"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Rizal Park Lawn -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/location_card_background">

                    <View
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/photo_placeholder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rizal Park Lawn"
                            android:textColor="@color/ink"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="serif" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Park · Saved location"
                            android:textColor="@color/muted_dark"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Rooftop Lounge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/location_card_background">

                    <View
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/photo_placeholder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rooftop Lounge"
                            android:textColor="@color/ink"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="serif" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Food · Nearby"
                            android:textColor="@color/muted_dark"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Noodle House -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/location_card_background">

                    <View
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/photo_placeholder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Noodle House"
                            android:textColor="@color/ink"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="serif" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Food · Nearby"
                            android:textColor="@color/muted_dark"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Intramuros Walls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/location_card_background">

                    <View
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/photo_placeholder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Intramuros Walls"
                            android:textColor="@color/ink"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="serif" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Tourist spot · Nearby"
                            android:textColor="@color/muted_dark"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>