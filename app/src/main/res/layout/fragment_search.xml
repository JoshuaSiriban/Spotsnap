<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="24dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="serif"
            android:text="Search"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/search_box_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Search"
            android:src="@drawable/ic_search"
            app:tint="@color/ink" />

        <EditText
            android:id="@+id/search_edit_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Search places, people or categories"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:padding="0dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted_dark"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/search_clear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear search"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/muted_dark" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/search_chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip android:id="@+id/search_chip_restaurants" style="@style/Widget.SpotSnap.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Restaurants"/>
            <com.google.android.material.chip.Chip android:id="@+id/search_chip_cafes" style="@style/Widget.SpotSnap.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cafés"/>
            <com.google.android.material.chip.Chip android:id="@+id/search_chip_parks" style="@style/Widget.SpotSnap.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Parks"/>
            <com.google.android.material.chip.Chip android:id="@+id/search_chip_tourist" style="@style/Widget.SpotSnap.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tourist Attractions"/>
            <com.google.android.material.chip.Chip android:id="@+id/search_chip_hangouts" style="@style/Widget.SpotSnap.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hangouts"/>
            <com.google.android.material.chip.Chip android:id="@+id/search_chip_other" style="@style/Widget.SpotSnap.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Other"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/search_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="10dp"
        android:letterSpacing="0.1"
        android:text="LOADING..."
        android:textColor="@color/muted_dark"
        android:textSize="12sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp" />
</LinearLayout>