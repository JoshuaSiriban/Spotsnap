<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp">


        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Search"
                android:textColor="#555555"
                android:textSize="18sp" />

            <TextView
                android:layout_width="35dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="↗"
                android:textColor="#555555"
                android:textSize="22sp" />

            <TextView
                android:layout_width="35dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="↓"
                android:textColor="#555555"
                android:textSize="22sp" />

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- SEARCH BAR -->
        <!-- ========================================================= -->

        <EditText
            android:id="@+id/search_input"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/search_box_background"
            android:hint="Search SpotSnap"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#333333"
            android:textColorHint="#777777"
            android:textSize="12sp" />


        <!-- ========================================================= -->
        <!-- CATEGORY BUTTONS -->
        <!-- ========================================================= -->

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/category_button_background"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Food"
                    android:textColor="#555555"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/category_button_background"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Hang Out"
                    android:textColor="#555555"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/category_button_background"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Tourist Spot"
                    android:textColor="#555555"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/category_button_background"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Saved"
                    android:textColor="#555555"
                    android:textSize="10sp" />

            </LinearLayout>

        </HorizontalScrollView>


        <!-- ========================================================= -->
        <!-- RECENT TITLE -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="13dp"
            android:gravity="center_vertical"
            android:text="Recent"
            android:textColor="#777777"
            android:textSize="11sp" />


        <!-- ========================================================= -->
        <!-- RECENT - CAFE OCAMPO -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:gravity="center"
                android:text="◷"
                android:textColor="#777777"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cafe Ocampo"
                    android:textColor="#444444"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Food · Malate"
                    android:textColor="#888888"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- RECENT - RIZAL PARK -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:gravity="center"
                android:text="◷"
                android:textColor="#777777"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rizal Park Lawn"
                    android:textColor="#444444"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tourist Spot · Ermita"
                    android:textColor="#888888"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- SUGGESTED NEARBY TITLE -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Suggested nearby"
            android:textColor="#777777"
            android:textSize="11sp" />


        <!-- ========================================================= -->
        <!-- ROOFTOP LOUNGE -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:gravity="center"
                android:text="⌾"
                android:textColor="#777777"
                android:textSize="21sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rooftop Lounge"
                    android:textColor="#444444"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hang Out · 2.3 km"
                    android:textColor="#888888"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- NOODLE HOUSE -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:gravity="center"
                android:text="⌾"
                android:textColor="#777777"
                android:textSize="21sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Noodle House"
                    android:textColor="#444444"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Food · 2.8 km"
                    android:textColor="#888888"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- INTRAMUROS WALLS -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:gravity="center"
                android:text="⌾"
                android:textColor="#777777"
                android:textSize="21sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Intramuros Walls"
                    android:textColor="#444444"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tourist Spot · 3.0 km"
                    android:textColor="#888888"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>