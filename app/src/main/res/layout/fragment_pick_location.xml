<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream" android:fitsSystemWindows="true">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/pick_map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:layout_margin="16dp" android:background="@drawable/bg_search_bar" android:elevation="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="16dp" android:paddingTop="4dp" android:paddingBottom="4dp">
        <ImageButton android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Back" android:src="@drawable/ic_back" app:tint="@color/ink"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Place the pin" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap the map or drag the pin" android:textColor="@color/muted_dark" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton android:id="@+id/btn_confirm_location" android:layout_width="match_parent" android:layout_height="60dp" android:layout_gravity="bottom" android:layout_margin="16dp" android:text="Use this location" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/mustard" app:backgroundTint="@color/ink" app:cornerRadius="18dp" app:icon="@drawable/ic_pin" app:iconTint="@color/mustard" app:iconGravity="textStart"/>
</FrameLayout>