<?xml version="1.0" encoding="utf-8"?>
<!-- One place in a list (Search, Saved Locations, Profile). The whole row opens the place;
     the "Map" link on the right shows it on the map. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/location_card_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/row_photo"
        android:layout_width="52dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_photo_round"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/muted_dark"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_map"
        android:layout_width="48dp"
        android:layout_height="58dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="Map"
        android:textColor="@color/coral"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>