<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream"
    android:fitsSystemWindows="true"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">


    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical">

        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Saved Locations"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- CAFE OCAMPO -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/location_card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">


        <!-- COLOR BLOCK -->

        <View
            android:layout_width="48dp"
            android:layout_height="58dp"
            android:background="#DFC8A5" />


        <!-- LOCATION INFORMATION -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cafe Ocampo"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Food · Malate"
                android:textColor="@color/muted_dark"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- MAP -->

        <TextView
            android:layout_width="44dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:text="Map"
            android:textColor="@color/coral"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- ROOFTOP LOUNGE -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/location_card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <View
            android:layout_width="48dp"
            android:layout_height="58dp"
            android:background="#C9C3E5" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rooftop Lounge"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Hang Out · Makati"
                android:textColor="@color/muted_dark"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:layout_width="44dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:text="Map"
            android:textColor="@color/coral"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- INTRAMUROS WALLS -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/location_card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <View
            android:layout_width="48dp"
            android:layout_height="58dp"
            android:background="#CEE4C5" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Intramuros Walls"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tourist Spot · Manila"
                android:textColor="@color/muted_dark"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:layout_width="44dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:text="Map"
            android:textColor="@color/coral"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- RAMEN CORNER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/location_card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <View
            android:layout_width="48dp"
            android:layout_height="58dp"
            android:background="#D4B58D" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ramen Corner"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Food · Quezon City"
                android:textColor="@color/muted_dark"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:layout_width="44dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:text="Map"
            android:textColor="@color/coral"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>