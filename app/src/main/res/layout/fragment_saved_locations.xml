<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F4F5"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">


    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:gravity="center_vertical"
        android:text="←  Saved Locations"
        android:textColor="#333333"
        android:textSize="13sp"
        android:textStyle="bold" />


    <!-- ========================================================= -->
    <!-- CAFE OCAMPO -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/location_card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="7dp">


        <!-- COLOR BLOCK -->

        <View
            android:layout_width="42dp"
            android:layout_height="50dp"
            android:background="#DFC8A5" />


        <!-- LOCATION INFORMATION -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cafe Ocampo"
                android:textColor="#333333"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Food · Malate"
                android:textColor="#888888"
                android:textSize="9sp" />

        </LinearLayout>


        <!-- MAP -->

        <TextView
            android:layout_width="35dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="Map"
            android:textColor="#777777"
            android:textSize="8sp" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- ROOFTOP LOUNGE -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/location_card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="7dp">

        <View
            android:layout_width="42dp"
            android:layout_height="50dp"
            android:background="#C9C3E5" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rooftop Lounge"
                android:textColor="#333333"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hang Out · Makati"
                android:textColor="#888888"
                android:textSize="9sp" />

        </LinearLayout>

        <TextView
            android:layout_width="35dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="Map"
            android:textColor="#777777"
            android:textSize="8sp" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- INTRAMUROS WALLS -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/location_card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="7dp">

        <View
            android:layout_width="42dp"
            android:layout_height="50dp"
            android:background="#CEE4C5" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Intramuros Walls"
                android:textColor="#333333"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tourist Spot · Manila"
                android:textColor="#888888"
                android:textSize="9sp" />

        </LinearLayout>

        <TextView
            android:layout_width="35dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="Map"
            android:textColor="#777777"
            android:textSize="8sp" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- RAMEN CORNER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/location_card_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="7dp">

        <View
            android:layout_width="42dp"
            android:layout_height="50dp"
            android:background="#D4B58D" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ramen Corner"
                android:textColor="#333333"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Food · Quezon City"
                android:textColor="#888888"
                android:textSize="9sp" />

        </LinearLayout>

        <TextView
            android:layout_width="35dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="Map"
            android:textColor="#777777"
            android:textSize="8sp" />

    </LinearLayout>

</LinearLayout>