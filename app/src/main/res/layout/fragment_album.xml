<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">


        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="←  Album"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />


        <!-- ========================================================= -->
        <!-- CAFE OCAMPO -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:text="CAFE OCAMPO · 3 PHOTOS · PUBLIC"
            android:textColor="#555555"
            android:textSize="8sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal">


            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="#DFC8A5"
                android:scaleType="centerCrop" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="2dp"
                android:background="#D0B48D"
                android:scaleType="centerCrop" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:background="#BFA17D"
                android:scaleType="centerCrop" />

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- RIZAL PARK LAWN -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="13dp"
            android:gravity="center_vertical"
            android:text="RIZAL PARK LAWN · 2 PHOTOS · PUBLIC"
            android:textColor="#555555"
            android:textSize="8sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="#CEE4C5"
                android:scaleType="centerCrop" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:background="#BBD9E5"
                android:scaleType="centerCrop" />

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- MY SECRET SPOT -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="13dp"
            android:gravity="center_vertical"
            android:text="MY SECRET SPOT · 1 PHOTO · PRIVATE"
            android:textColor="#555555"
            android:textSize="8sp"
            android:textStyle="bold" />


        <ImageView
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:background="#C8C2E5"
            android:scaleType="centerCrop" />


        <!-- ========================================================= -->
        <!-- EDIT / DELETE BUTTONS -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="13dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/album_button_background"
                android:gravity="center"
                android:text="Edit post"
                android:textColor="#333333"
                android:textSize="9sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:background="@drawable/album_button_background"
                android:gravity="center"
                android:text="Delete post"
                android:textColor="#333333"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>